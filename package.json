{
	"name": "pi-sudo",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Explicit, temporary sudo access for interactive Pi sessions",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spi-ca/pi-sudo.git"
	},
	"homepage": "https://github.com/spi-ca/pi-sudo#readme",
	"bugs": {
		"url": "https://github.com/spi-ca/pi-sudo/issues"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@earendil-works/pi-tui": "0.87.1",
		"@types/bun": "1.3.14",
		"@types/node": "24.2.0",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"pi-ask-user": "github:spi-ca/pi-ask-user#v20260927-1"
	},
	"scripts": {
		"test": "bun test",
		"check": "tsc --noEmit",
		"docs:diagrams": "bun scripts/sync-diagrams.ts",
		"docs:render": "bun scripts/render-diagrams.ts && bun run docs:diagrams",
		"docs:check": "bun scripts/sync-diagrams.ts --check"
	}
}
